# AIDriveNote — NAS 侧环境变量模板
#
# 使用：cp .env.nas.example .env && vi .env
# ⚠️ .env 含明文密码，务必确认已被 .gitignore 覆盖（项目根 .gitignore:7 已含 .env）

# ── 数据目录 ──
# 所有持久化数据根目录（Postgres / uploads / wireguard 配置）
NAS_DATA_ROOT=/volume1/apps/aidrive

# ── 数据库 ──
# ⚠️ 密码请自行生成：openssl rand -base64 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_PG_PASSWORD
POSTGRES_DB=ai_drive_note
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_PG_PASSWORD@postgres:5432/ai_drive_note
DATABASE_URL_SYNC=postgresql://postgres:CHANGE_ME_PG_PASSWORD@postgres:5432/ai_drive_note

# ── 应用密钥 ──
# ⚠️ 必需：openssl rand -hex 32
SECRET_KEY=CHANGE_ME_HEX32

# ── 域名与跨域 ──
CORS_ORIGINS=https://www.aiignite.com.cn,https://aiignite.com.cn
VITE_BASE_PATH=/note/
VITE_API_URL=/note/api/v1
NGINX_SUBPATH=1
APP_HEALTH_PATH=/note/health

# ── 单点登录 ──
# ⚠️ SSO_SECRET_KEY 必须与腾讯云上现有部署一致，否则已登录用户会掉线
SSO_ENABLED=true
SSO_ISSUER=aidriveall
SSO_COOKIE_NAME=aidrive_token
SSO_SECRET_KEY=CHANGE_ME_SSO_SECRET
ADMIN_EMAIL=

# ── AI（云端，经 WireGuard）──
# 云端 WireGuard 地址为 10.10.0.1；确保云端 Ollama 监听 0.0.0.0:11434
OLLAMA_BASE_URL=http://10.10.0.1:11434
OLLAMA_MODEL=qwen2.5

# ── 语音转写（云端，经 WireGuard）──
NOTE_ASR_MODE=remote
NOTE_ASR_REMOTE_URL=http://10.10.0.1:8090/api/v1/transcribe
NOTE_ASR_REMOTE_API_KEY=CHANGE_ME_SHARED_ASR_KEY
NOTE_ASR_REMOTE_TIMEOUT=3600
# 不在 NAS 上跑 Whisper，保持 false
NOTE_ASR_FALLBACK_LOCAL=false

# ── 邮件 ──
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_USE_SSL=true
# 首次部署保持 true（不真实投递），确认无误后改 false
EMAIL_MOCK=true

# ── AI 联网搜索 ──
AI_WEB_SEARCH_ENABLED=true
AI_WEB_SEARCH_TIMEOUT=10
AI_WEB_SEARCH_MAX_RESULTS=5
