DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_drive_note
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/ai_drive_note
SECRET_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
CORS_ORIGINS=http://localhost:3270
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
AI_PROVIDER=ollama
# Optional cloud providers (configure in /settings/ai/models)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
DEBUG=false
API_DOCS_ENABLED=true
# SSO (AIDriveAll portal) — set SSO_SECRET_KEY to portal SECRET_KEY
SSO_ENABLED=false
SSO_SECRET_KEY=
SSO_ISSUER=aidriveall
# 笔记语音转写（ASR）：remote=局域网 GPU 网关（推荐，后端镜像无需 ffmpeg）；local=本机 faster-whisper
NOTE_ASR_MODE=remote
NOTE_ASR_REMOTE_URL=
NOTE_ASR_REMOTE_API_KEY=
NOTE_ASR_REMOTE_TIMEOUT=3600
NOTE_ASR_FALLBACK_LOCAL=false
NOTE_WHISPER_MODEL=medium
NOTE_WHISPER_LANGUAGE=zh
NOTE_WHISPER_DEVICE=cpu
NOTE_WHISPER_COMPUTE_TYPE=int8
NOTE_MAX_RECORDING_BYTES=524288000
