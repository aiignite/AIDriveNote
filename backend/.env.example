DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_drive_note
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/ai_drive_note
SECRET_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
CORS_ORIGINS=http://localhost:3270
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
AI_PROVIDER=ollama
# Optional cloud providers (configure in /settings/ai/models)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
DEBUG=false
API_DOCS_ENABLED=true
# SSO (AIDriveAll portal) — set SSO_SECRET_KEY to portal SECRET_KEY
SSO_ENABLED=false
SSO_SECRET_KEY=
SSO_ISSUER=aidriveall
# SSO 登录是否为首次出现的用户自动建号；公网测试部署建议 false（仅管理员建好的账号可登录）
SSO_AUTO_CREATE_USERS=true
# ── 公网测试部署防护 ──
# 是否开放自助注册（邮箱验证码流程）；公网测试部署建议 false，账号由管理员创建
SELF_REGISTRATION_ENABLED=true
# 每个用户笔记数量上限（含回收站）；0 表示不限制
USER_MAX_NOTES=100
# 单个上传文件大小上限（笔记图片资产 / AI 对话附件）
USER_MAX_UPLOAD_BYTES=2097152
# 笔记语音转写（ASR）：remote=局域网 GPU 网关（推荐，后端镜像无需 ffmpeg）；local=本机 faster-whisper
NOTE_ASR_MODE=remote
NOTE_ASR_REMOTE_URL=
NOTE_ASR_REMOTE_API_KEY=
NOTE_ASR_REMOTE_TIMEOUT=3600
NOTE_ASR_FALLBACK_LOCAL=false
NOTE_WHISPER_MODEL=medium
NOTE_WHISPER_LANGUAGE=zh
NOTE_WHISPER_DEVICE=cpu
NOTE_WHISPER_COMPUTE_TYPE=int8
NOTE_MAX_RECORDING_BYTES=26214400
# 邮件发送（QQ SMTP；用于笔记分享与注册验证码）
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_USE_SSL=true
# true 时只记日志不发信（验证码会打印到后端日志）；生产必须改为 false 才会真实发信
EMAIL_MOCK=true
# 注册验证码：有效期分钟数 / 位数 / 重发冷却秒 / 最大错误尝试次数
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_LENGTH=6
EMAIL_CODE_SEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_VERIFY_ATTEMPTS=5
