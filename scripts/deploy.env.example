# AIDriveNote 远程部署配置
# 复制为 scripts/deploy.env 并填写（deploy.env 勿提交 git）

AIDRIVENOTE_DEPLOY_HOST=43.134.98.176
AIDRIVENOTE_DEPLOY_USER=ubuntu
AIDRIVENOTE_DEPLOY_PATH=/home/ubuntu/AIDriveNote
AIDRIVENOTE_FRONTEND_PORT=3270
# 备注：3270 直连仅作调试入口（HTTP/1.1，单域名并发上限 6）；
# 面向用户请使用 https://aiignite.com.cn/note/（HTTP/2 + TLS，首屏更快）。

# 生产环境（aiignite.com.cn/note）— enable-sso.sh 会自动写入，亦可手动确认：
VITE_BASE_PATH=/note/
VITE_API_URL=/note/api/v1
NGINX_SUBPATH=1
APP_HEALTH_PATH=/note/health
CORS_ORIGINS=https://aiignite.com.cn,https://www.aiignite.com.cn

# ── 语音转写（remote asr_gateway；NOTE_ASR_* 透传到 backend 容器）──
# 模式：remote（调用 asr_gateway）| local（backend 内 faster-whisper，默认镜像未装）
NOTE_ASR_MODE=remote
# 必须是【完整端点】而非 base URL：backend 直接以该值作为 POST 目标。
# 同 compose 内的网关固定为 http://asr_gateway:8090/api/v1/transcribe；
# 若指向局域网独立主机则替换主机名，如 http://192.168.1.10:8090/api/v1/transcribe
NOTE_ASR_REMOTE_URL=http://asr_gateway:8090/api/v1/transcribe
# 必须与网关侧 ASR_API_KEY 完全一致（compose 中由本变量注入网关）
NOTE_ASR_REMOTE_API_KEY=
# 长录音需调大（秒）
NOTE_ASR_REMOTE_TIMEOUT=3600
# 远程失败是否降级本机 CPU 转写
NOTE_ASR_FALLBACK_LOCAL=false
# local 兜底/降级参数（无 GPU 用 cpu/int8）
NOTE_WHISPER_MODEL=small
NOTE_WHISPER_LANGUAGE=zh
NOTE_WHISPER_DEVICE=cpu
NOTE_WHISPER_COMPUTE_TYPE=int8

# ── asr_gateway 容器侧推理参数（ASR_* 命名，仅网关使用）──
# 权重规格：本机 2 核 CPU 建议 small；有 GPU 可升 medium/large-v3
ASR_MODEL=small
ASR_LANGUAGE=zh
# 有 GPU 改 cuda + float16
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# 启动即预热模型，避免首个请求冷启动
ASR_PRELOAD=1
# 资源上限：防止转写拖垮同机其它服务（按服务器规格调整）
ASR_MEM_LIMIT=1536m
ASR_CPUS=1.5
